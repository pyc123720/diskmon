<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration (template).
  Upload this in SignPath > Project > Artifact configurations.
  Slug suggestion: diskmon-exe
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>

  <!-- The workflow uploads dist/ as the artifact; sign the exe inside it. -->
  <zip-file>
    <pe-file path="diskmon-go.exe">
      <authenticode-sign
        description="diskmon %version%"
        url="https://github.com/pyc123720/diskmon" />
    </pe-file>
  </zip-file>
</artifact-configuration>
